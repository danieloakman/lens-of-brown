{
	"name": "lens-of-brown",
	"version": "1.0.2",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "gh-pages -d build --nojekyll -u \"Daniel Oakman <42539848+danieloakman@users.noreply.github.com>\"",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"upgrade-interactive": "bunx npm-check-updates -i -c 7",
		"update-insta-posts": "bun run ./scripts/update-insta-posts.ts",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
